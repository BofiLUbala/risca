NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Notifications push (Firebase Cloud Messaging)
# Console Firebase > Parametres du projet > General, puis Cloud Messaging pour la cle VAPID.
# Sans ces variables, la section « Notifications push » du profil indique simplement
# que la fonction n'est pas configuree ; le reste de l'application est inchange.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
