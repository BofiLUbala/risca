node_modules/
dist/
.next/
.expo/
*.log
.env
.env.local
# Fichiers televerses a l'execution. Motif ancre a la racine : un simple
# `uploads/` vaut pour tout dossier de ce nom a n'importe quelle profondeur et
# excluait backend/src/modules/uploads/, du code source.
/backend/uploads/
graphify-out/
coverage/

# Identifiants Firebase : jamais dans le depot
firebase-service-account.json
**/firebase-service-account*.json
google-services.json
GoogleService-Info.plist
.next-clean/

# Sauvegardes de base : jamais dans le depot
backups/

# Variables d'environnement : seuls les fichiers *.example sont suivis.
# Couvre aussi les copies de travail (.env.bak, .env.local.bak...).
.env.*
!.env.example
!.env.northflank.example

# Cle du compte de service Google Play : injectee par le workflow depuis un
# secret GitHub, jamais dans le depot.
google-play-service-account.json
