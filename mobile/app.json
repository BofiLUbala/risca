{
  "expo": {
    "name": "RISAC",
    "slug": "risac",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "risac",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.risac.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "org.risac.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "RISAC utilise vos photos pour illustrer les publications et les justificatifs."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RISAC enregistre le lieu de vos rapports de visite."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#174A70"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:4000/api",
      "apiOrigin": "http://localhost:4000",
      "eas": {
        "projectId": "a1b6612e-1b63-44d9-9b2f-3f1f40b611eb"
      }
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
