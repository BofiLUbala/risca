# Variables a coller dans un secret group Northflank (format .env accepte tel
# quel par l'interface). Voir docs/NORTHFLANK.md pour la provenance de chaque
# valeur. Ne jamais committer la version remplie.

# ─── Base de donnees : URI INTERNE de l'addon Postgres ───
DATABASE_URL=postgres://user:motdepasse@risca-postgres.addon.code.run:5432/risca

# ─── Secret de signature des jetons : openssl rand -hex 32 ───
JWT_SECRET=
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d

# ─── URL du front : liens dans les e-mails et origines CORS autorisees ───
APP_WEB_URL=https://votre-app.vercel.app
CORS_ORIGINS=https://votre-app.vercel.app

# ─── Regles metier ───
UPLOAD_DIR=./uploads
PLATFORM_FEE_PERCENT=5
PROJECT_APPROVAL_THRESHOLD_USD=1000
VALIDATION_ESCALATION_HOURS=72

# ─── E-mails (codes OTP d'activation) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RISAC <no-reply@risca.org>

# ─── Notifications push (Firebase) : optionnel ───
# Sans ces trois variables la plateforme tourne, mais n'envoie aucun push ;
# tout reste consultable dans l'application. Cle privee sur une seule ligne,
# retours a la ligne echappes en \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# NODE_ENV et PORT sont deja fixes dans l'image (Dockerfile) : ne les
# redefinir que pour changer le port expose.
