DATABASE_URL="postgresql://risac:risac_dev_pwd@localhost:5444/risac?schema=public"
PORT=4000
NODE_ENV="development"
JWT_SECRET="risac_dev_access_secret_change_in_production"
JWT_EXPIRES_IN="30m"
# Les jetons de rafraichissement sont des valeurs aleatoires hachees en base : pas de second secret.
JWT_REFRESH_EXPIRES_IN="30d"
# Adresse du site web : sert aux liens d'activation et aux liens des notifications push.
APP_WEB_URL="http://localhost:3100"
# Origines autorisees (CORS), separees par des virgules : site web, Expo web, Expo Go.
CORS_ORIGINS="http://localhost:3100,http://localhost:8081,http://localhost:19006"
UPLOAD_DIR="./uploads"
PLATFORM_FEE_PERCENT=5
PROJECT_APPROVAL_THRESHOLD_USD=1000
VALIDATION_ESCALATION_HOURS=72

# Envoi d'e-mails (code OTP d'activation). Gmail : mot de passe d'application, port 587.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Facultatif (durcissement) : clé d'installation exigée en plus pour créer le compte Super Admin sur /admin.
# Le Super Admin choisit lui-même sa clé administrateur à la création ; cette variable empêche seulement
# qu'un inconnu crée le compte avant vous sur un serveur fraîchement déployé. Laisser vide pour la désactiver.
ADMIN_SETUP_KEY=""
# Tests uniquement : n'envoie aucun e-mail et renvoie le code dans la réponse de l'API.
# Jamais pris en compte quand NODE_ENV=production.
MAIL_ECHO_OTP=false

# ─── Notifications push (Firebase Cloud Messaging) ───
# Compte de service Firebase : Console > Parametres du projet > Comptes de service.
# Sans ces variables, la plateforme fonctionne normalement mais n'envoie aucun push ;
# les notifications restent consultables dans l'application.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Cle privee sur une seule ligne, les sauts de ligne etant echappes (barre oblique inverse + n)
FIREBASE_PRIVATE_KEY=""
# Variante : chemin vers le fichier JSON du compte de service, au lieu des trois ci-dessus.
# GOOGLE_APPLICATION_CREDENTIALS="./firebase-service-account.json"

# --- Analyse antivirus des fichiers (section 12) ---
# Sans CLAMAV_HOST, seul le controle des octets de signature s'applique :
# un executable deguise est refuse, mais aucun virus n'est detecte.
CLAMAV_HOST=""
CLAMAV_PORT=3310

# --- Sauvegardes quotidiennes (section 12) ---
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=14
# Si PostgreSQL tourne dans un conteneur et que pg_dump n'est pas installe sur la machine :
# PG_DUMP_BIN="docker exec -i risac_postgres pg_dump"
# Variante : sauvegarder une autre base que DATABASE_URL.
# BACKUP_DATABASE_URL=""
# "true" coupe les taches planifiees (sauvegardes, escalade des validations, prelevements des
# parrainages, rapprochement des comptes) : a reserver aux instances secondaires.
DISABLE_SCHEDULERS=false

# --- Passerelles de paiement ---
# Sans cle, la passerelle bascule sur le bac a sable interne : aucun paiement reel n'est debite.
# Ces valeurs sont des secrets serveur, a ne jamais committer.
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
FLUTTERWAVE_SECRET_KEY=""
CINETPAY_API_KEY=""
PAWAPAY_API_TOKEN=""
MAXICASH_API_KEY=""

# --- Chiffrement des champs sensibles (section 12) ---
# NON IMPLEMENTE : cette cle n'est pas encore lue par l'API, les champs psychotrauma et
# medicaux sont en clair en base (voir docs/CONFORMITE-PLAN.md). Ne pas compter dessus.
# FIELD_ENCRYPTION_KEY=""
