# Modele du fichier /opt/risac/.env sur le droplet.
#
# deploy.sh le copie sur le serveur et remplace les valeurs __...__ par des
# secrets aleatoires, une seule fois (un .env existant n'est jamais ecrase).
# Les valeurs vides (SMTP, Firebase, paiements) se completent ensuite a la
# main : `nano /opt/risac/.env` puis `docker compose up -d`.

# ─── Reseau ───
# Nom de domaine de l'API (api.exemple.org) ; ":80" tant qu'il n'existe pas.
API_DOMAIN=:80
# Adresse du site web (liens des e-mails) et origines CORS autorisees.
APP_WEB_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100

# ─── Secrets generes ───
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
JWT_SECRET=__JWT_SECRET__
# Demandee une seule fois, a la creation du compte Super Admin sur /admin.
ADMIN_SETUP_KEY=__ADMIN_SETUP_KEY__

JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Regles metier ───
PLATFORM_FEE_PERCENT=5
PROJECT_APPROVAL_THRESHOLD_USD=1000
VALIDATION_ESCALATION_HOURS=72
MAIL_ECHO_OTP=false

# ─── E-mails (codes OTP d'activation) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Notifications push (Firebase) : facultatif ───
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Passerelles de paiement : sans cle, bac a sable interne (aucun debit reel) ───
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
FLUTTERWAVE_SECRET_KEY=
CINETPAY_API_KEY=
PAWAPAY_API_TOKEN=
MAXICASH_API_KEY=
